# Copy this file to .env and fill in whichever LLM provider you want to use.
# You only need ONE of these providers configured.

# Which provider to use: "anthropic" | "openai" | "groq" | "none"
LLM_PROVIDER=anthropic

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI - https://platform.openai.com/
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq - https://console.groq.com/ (free tier, very fast CPU-friendly for you
# since inference runs on their servers, not your laptop)
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ---- API security ----
# REQUIRED if you deploy this publicly (see docker-compose / cloud deploy).
# Leave blank for local-only use on localhost - auth is skipped when blank.
# Generate a random one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ---- Local paths (defaults are fine) ----
QDRANT_PATH=./data/qdrant_db
BM25_INDEX_PATH=./data/bm25_index.pkl
KG_PATH=./data/knowledge_graph.gpickle
COLLECTION_NAME=legal_docs

# ---- Embedding / reranker models (small, CPU-friendly) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ----
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_RERANK=5
RRF_K=60
